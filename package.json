{
  "name": "portfolio-nextjs",
  "version": "2.4.71",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 192.168.1.103 -p 4000",
    "dev:ci": "next dev --turbopack -p 4000",
    "build": "next build --webpack && node scripts/defer-portrait-scripts.mjs",
    "vercel-build": "drizzle-kit migrate && next build --webpack && node scripts/defer-portrait-scripts.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:spell": "cspell --no-progress \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.md\"",
    "check:routes": "node scripts/check-routes.mjs",
    "check:vitals": "node scripts/check-vitals.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.4.1",
    "@vercel/blob": "^2.9.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.43.0",
    "geist": "^1.7.2",
    "lenis": "1.3.11",
    "lucide-react": "0.542.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.28.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "sharp": "0.35.5",
    "zod": "^4.6.7",
    "source-map-js": "^1.2.2"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.1",
    "@img/sharp-linux-x64": "0.35.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cspell": "^8.19.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vercel": "^65.2.0",
    "vitest": "^4.1.11"
  },
  "description": "Adrian Cristache's portfolio: Next.js App Router site with a Postgres-backed admin.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristache-labs/portfolio-nextjs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aristache-labs/portfolio-nextjs/issues"
  },
  "homepage": "https://github.com/aristache-labs/portfolio-nextjs#readme"
}
